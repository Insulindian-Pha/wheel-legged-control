<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- Gazebo配置文件 - 包含所有Gazebo特定的配置 -->

<!-- Gazebo材质定义 - 匹配MuJoCo中的颜色 -->
<gazebo reference="base_link">
  <material>Gazebo/Tertiary</material>
</gazebo>

<gazebo reference="Left_front_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Left_front_child1_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Left_front_child2_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Left_front_child3_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Left_rear_link">
  <material>Gazebo/Grey</material>
</gazebo>

<gazebo reference="Left_rear_child1_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Left_Wheel_link">
  <material>Gazebo/Grey</material>
</gazebo>

<gazebo reference="Right_front_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Right_front_child1_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Right_front_child2_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Right_front_child3_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Right_rear_link">
  <material>Gazebo/Grey</material>
</gazebo>

<gazebo reference="Right_rear_child1_link">
  <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="Right_Wheel_link">
  <material>Gazebo/Grey</material>
</gazebo>

<!-- Gazebo关节配置 - 包含关节摩擦力和动力学参数 -->

<!-- 左侧前腿关节 -->
<gazebo reference="Left_front_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Left_front_child1_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Left_front_child2_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Left_front_child3_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<!-- 左侧后腿关节 -->
<gazebo reference="Left_rear_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Left_rear_child1_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<!-- 左侧轮子关节 -->
<gazebo reference="Left_Wheel_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <effort>30</effort>
    <velocity>100</velocity>
  </limit>
  <dynamics>
    <damping>0.01</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<!-- 右侧前腿关节 -->
<gazebo reference="Right_front_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Right_front_child1_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
