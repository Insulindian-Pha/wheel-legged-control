    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Right_front_child2_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Right_front_joint3_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<!-- 右侧后腿关节 -->
<gazebo reference="Right_rear_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
    <friction>0.1</friction>
  </dynamics>
</gazebo>

<gazebo reference="Right_rear_child1_joint">
  <implicitSpringDamper>1</implicitSpringDamper>
  <stopCfm>0.00001</stopCfm>
  <stopErp>0.1</stopErp>
  <fudgeFactor>0.5</fudgeFactor>
  <limit>
    <lower>-3.14</lower>
    <upper>3.14</upper>
    <effort>30</effort>
    <velocity>10</velocity>
  </limit>
  <dynamics>
    <damping>0.1</damping>
