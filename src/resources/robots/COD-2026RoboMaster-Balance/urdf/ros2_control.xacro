<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_mujoco" default="false"/>
    <xacro:arg name="mujoco_model" default=""/>

    <xacro:if value="$(arg use_mujoco)">
        <!-- ROS2 Control for MuJoCo -->
        <ros2_control name="MujocoSystem" type="system">
            <hardware>
                <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                <param name="mujoco_model">$(arg mujoco_model)</param>
                <param name="sim_speed_factor">1.0</param>
                <!-- Optional: Set window resolution. If not set or set to 0, uses primary monitor resolution -->
                <param name="window_width">1080</param> 
                <param name="window_height">720</param> 
            </hardware>
            <joint name="Left_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Left_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Left_Wheel_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_Wheel_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            
            <!-- IMU Sensor -->
            <sensor name="imu_sensor">
                <param name="mujoco_type">imu</param>
                <param name="mujoco_sensor_name">imu</param>
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>
        </ros2_control>
    </xacro:if>

    <xacro:if value="$(arg use_gazebo)">
        <!-- Gazebo ROS2 Control Plugin -->
        <gazebo>
            <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                <parameters>$(find bringup)/config/cod_balance_controllers.yaml</parameters>
            </plugin>
        </gazebo>

        <!-- ROS2 Control for Gazebo -->
        <ros2_control name="CodBalanceHardwareInterface" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="Left_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Left_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Left_Wheel_joint">
                <command_interface name="velocity" />
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
            <joint name="Right_Wheel_joint">
                <command_interface name="velocity" />
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
        </ros2_control>
    </xacro:if>

    <xacro:unless value="$(arg use_gazebo)">
        <xacro:unless value="$(arg use_mujoco)">
            <!-- ROS2 Control for Real Hardware/Mock -->
        <ros2_control name="CodBalanceHardwareInterface" type="system">
            <hardware>
                <plugin>librmcs_hardware/LibrmcsSystem</plugin>
                <param name="usb_pid">-1</param>
                <param name="startup_timeout_ms">1500</param>
                <param name="command_timeout_ms">100</param>
                <param name="allow_partial_feedback">true</param>
            </hardware>
            <joint name="Left_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">P1010B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x55</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
            <joint name="Left_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">P1010B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x56</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
            <joint name="Left_Wheel_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">M1505B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x9E</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
            <joint name="Right_front_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">P1010B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x52</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
            <joint name="Right_rear_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">P1010B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x51</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
            <joint name="Right_Wheel_joint">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="vendor">BM</param>
                <param name="model">M1505B_111</param>
                <param name="can_bus">can1</param>
                <param name="can_id">0x9A</param>
                <param name="encoder_zero_point">0</param>
                <param name="reduction_ratio">1</param>
                <param name="reversed">false</param>
                <param name="multi_turn_angle">false</param>
            </joint>
        </ros2_control>
        </xacro:unless>
    </xacro:unless>

</robot>
